# ---------------------------------------------------------------------------
# vibe-room configuration
#
# Copy to .env.local for development, or paste these into your host's
# environment settings (Netlify: Site configuration -> Environment variables).
#
#   cp .env.example .env.local
#
# .env* files are gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# REQUIRED — Postgres connection string (Neon, Supabase, Railway, local…).
DATABASE_URL="postgresql://user:password@host:5432/vibe_room?sslmode=require"

# REQUIRED — the code guests type to get into the room.
# There is no default and no fallback: if this is missing, nobody can join.
# Generate one:  openssl rand -base64 18
PARTY_PASSWORD=""

# REQUIRED — host password. Unlocks transport controls, reordering, skipping
# and the admin dock. Make it different from PARTY_PASSWORD and longer.
# Generate one:  openssl rand -base64 24
ADMIN_PASSWORD=""

# OPTIONAL — YouTube Data API v3 key. Without it search falls back to public
# Piped/Invidious instances, which work but are slower and flakier.
YOUTUBE_API_KEY=""
